# API key issued by the provider; required for authentication.
api_key               = "your-api-key"

# Project system code associated with the target project. Format GOV111222.
project_sys_code      = "your-project-sys-code"

# SSH keypair name to inject into the server.
keypair_name          = "your-keypair-name"

# Security group name to attach to the server.
securitygroup_name    = "your-securitygroup-name"

# Flavor name for the VM, for example CPU.small.
flavor_name           = ""

# Image repository and tag for the VM image.
image_repository      = "rocky"
image_tag             = "9"

# Optional network name to attach as a second NIC.
# If omitted or not found, the servers will use only the default network.
# optional_network_name = "your-network-name"

# VM password
server_password       = "your-password"

# Prefix for node naming
node_name_prefix      = "FUSION"

# Number of VMs to create (NOT counting bastion).
# Minimum 4: 1 Slurm headnode + 1 OpenStack controller + 2 worker/compute nodes.
# Worker nodes are dual-role: both Slurm compute and OpenStack compute.
total                 = 4

# --- OpenStack variables ---
enable_controller_fip   = false
enable_private_registry = false

# --- Slurm variables ---
cluster_name            = "poc-cluster"
db_password             = "slurmdbpass"
